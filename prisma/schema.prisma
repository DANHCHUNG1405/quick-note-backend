generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model notes {
  id             String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  topic_id       String        @db.Uuid
  title          String        @db.VarChar(255)
  content        String?
  is_pinned      Boolean?      @default(false)
  created_at     DateTime?     @default(now()) @db.Timestamp(6)
  updated_at     DateTime?     @default(now()) @db.Timestamp(6)
  deleted_at     DateTime?     @db.Timestamp(6)
  last_viewed_at DateTime?     @db.Timestamp(6)
  note_shares    note_shares[]
  topics         topics        @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notes_topic")
  todo_groups    todo_groups[]
  todos          todos[]

  @@index([topic_id], map: "idx_notes_topic_id")
}

model topics {
  id           String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String        @db.Uuid
  name         String        @db.VarChar(255)
  order_index  Int?          @default(0)
  created_at   DateTime?     @default(now()) @db.Timestamp(6)
  updated_at   DateTime?     @default(now()) @db.Timestamp(6)
  deleted_at   DateTime?     @db.Timestamp(6)
  parent_id    String?       @db.Uuid
  notes        notes[]
  todo_groups  todo_groups[]
  todos        todos[]
  topics       topics?       @relation("topicsTotopics", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_topics_parent")
  other_topics topics[]      @relation("topicsTotopics")
  users        users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_topics_user")

  @@index([user_id], map: "idx_topics_user_id")
  @@index([user_id, parent_id], map: "idx_topics_user_parent")
}

model users {
  id            String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email         String          @unique @db.VarChar(255)
  password_hash String
  created_at    DateTime?       @default(now()) @db.Timestamp(6)
  fullname      String?         @db.VarChar(50)
  note_shares   note_shares[]
  notifications notifications[]
  todo_groups   todo_groups[]
  todos         todos[]
  topics        topics[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model note_shares {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  note_id    String    @db.Uuid
  user_id    String    @db.Uuid
  permission String    @db.VarChar(20)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  notes      notes     @relation(fields: [note_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_note_shares_note")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_note_shares_user")

  @@unique([note_id, user_id], map: "unique_note_user")
  @@index([note_id], map: "idx_note_shares_note_id")
  @@index([user_id], map: "idx_note_shares_user_id")
}

model notifications {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String    @db.Uuid
  type       String    @db.VarChar(50)
  message    String
  is_read    Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notifications_user")

  @@index([user_id], map: "idx_notifications_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model todos {
  id           String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String       @db.Uuid
  topic_id     String?      @db.Uuid
  note_id      String?      @db.Uuid
  title        String       @db.VarChar(255)
  description  String?
  status       String       @default("PENDING") @db.VarChar(20)
  priority     String       @default("NORMAL") @db.VarChar(20)
  due_at       DateTime?    @db.Timestamp(6)
  completed_at DateTime?    @db.Timestamp(6)
  order_index  Int?         @default(0)
  created_at   DateTime?    @default(now()) @db.Timestamp(6)
  updated_at   DateTime?    @default(now()) @db.Timestamp(6)
  deleted_at   DateTime?    @db.Timestamp(6)
  group_id     String?      @db.Uuid
  todo_groups  todo_groups? @relation(fields: [group_id], references: [id], onUpdate: NoAction, map: "fk_todos_group")
  notes        notes?       @relation(fields: [note_id], references: [id], onUpdate: NoAction, map: "fk_todos_note")
  topics       topics?      @relation(fields: [topic_id], references: [id], onUpdate: NoAction, map: "fk_todos_topic")
  users        users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_todos_user")

  @@index([group_id], map: "idx_todos_group_id")
  @@index([user_id, group_id], map: "idx_todos_user_group")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model todo_groups {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id     String    @db.Uuid
  topic_id    String?   @db.Uuid
  note_id     String?   @db.Uuid
  name        String    @db.VarChar(255)
  description String?
  group_type  String    @default("CUSTOM") @db.VarChar(20)
  group_date  DateTime? @db.Date
  order_index Int?      @default(0)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  deleted_at  DateTime? @db.Timestamp(6)
  notes       notes?    @relation(fields: [note_id], references: [id], onUpdate: NoAction, map: "fk_todo_groups_note")
  topics      topics?   @relation(fields: [topic_id], references: [id], onUpdate: NoAction, map: "fk_todo_groups_topic")
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_todo_groups_user")
  todos       todos[]

  @@index([group_date], map: "idx_todo_groups_group_date")
  @@index([group_type], map: "idx_todo_groups_group_type")
  @@index([note_id], map: "idx_todo_groups_note_id")
  @@index([topic_id], map: "idx_todo_groups_topic_id")
  @@index([user_id, group_date], map: "idx_todo_groups_user_date")
  @@index([user_id], map: "idx_todo_groups_user_id")
}

enum todo_priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum todo_status {
  PENDING
  COMPLETED
  CANCELLED
}
