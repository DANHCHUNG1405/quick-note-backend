generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model notes {
  id             String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  topic_id       String        @db.Uuid
  title          String        @db.VarChar(255)
  content        String?
  is_pinned      Boolean?      @default(false)
  created_at     DateTime?     @default(now()) @db.Timestamp(6)
  updated_at     DateTime?     @default(now()) @db.Timestamp(6)
  deleted_at     DateTime?     @db.Timestamp(6)
  last_viewed_at DateTime?     @db.Timestamp(6)
  note_shares    note_shares[]
  topics         topics        @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notes_topic")

  @@index([topic_id], map: "idx_notes_topic_id")
}

model topics {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String   @db.Uuid
  name         String   @db.VarChar(255)
  order_index  Int?     @default(0)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)
  deleted_at   DateTime? @db.Timestamp(6)
  parent_id    String?  @db.Uuid
  notes        notes[]
  topics       topics?  @relation("topicsTotopics", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_topics_parent")
  other_topics topics[] @relation("topicsTotopics")
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_topics_user")

  @@index([user_id], map: "idx_topics_user_id")
  @@index([user_id, parent_id], map: "idx_topics_user_parent")
}

model users {
  id                   String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email                String          @unique @db.VarChar(255)
  password_hash        String?
  fullname             String?         @db.VarChar(50)
  avatar               String?         @db.VarChar(255)
  google_id            String?         @unique @db.VarChar(255)
  provider             String?         @default("LOCAL") @db.VarChar(50)
  refresh_token_hash   String?
  email_verified       Boolean         @default(false)
  verification_code    String?         @db.VarChar(255)
  verification_expires DateTime?       @db.Timestamp(6)
  created_at           DateTime?       @default(now()) @db.Timestamp(6)
  updated_at           DateTime?       @default(now()) @db.Timestamp(6)
  note_shares        note_shares[]
  notifications      notifications[]
  roadmaps           roadmaps[]
  task_lists         task_lists[]
  tasks              tasks[]
  topics             topics[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model note_shares {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  note_id    String    @db.Uuid
  user_id    String    @db.Uuid
  permission String    @db.VarChar(20)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  notes      notes     @relation(fields: [note_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_note_shares_note")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_note_shares_user")

  @@unique([note_id, user_id], map: "unique_note_user")
  @@index([note_id], map: "idx_note_shares_note_id")
  @@index([user_id], map: "idx_note_shares_user_id")
}

model notifications {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String    @db.Uuid
  type       String    @db.VarChar(50)
  message    String
  is_read    Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notifications_user")

  @@index([user_id], map: "idx_notifications_user_id")
}

model roadmaps {
  id          String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id     String        @db.Uuid
  name        String        @db.VarChar(255)
  description String?
  start_date  DateTime      @db.Date
  end_date    DateTime?     @db.Date
  status      String        @default("ACTIVE") @db.VarChar(20)
  color       String?       @db.VarChar(20)
  order_index Int?          @default(0)
  created_at  DateTime?     @default(now()) @db.Timestamp(6)
  updated_at  DateTime?     @default(now()) @db.Timestamp(6)
  deleted_at  DateTime?     @db.Timestamp(6)
  users       users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_roadmaps_user")
  tasks       tasks[]

  @@index([user_id], map: "idx_roadmaps_user_id")
  @@index([user_id, status], map: "idx_roadmaps_user_status")
}

model task_lists {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id     String    @db.Uuid
  name        String    @db.VarChar(255)
  description String?
  order_index Int?      @default(0)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  deleted_at  DateTime? @db.Timestamp(6)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_task_lists_user")
  tasks       tasks[]

  @@index([user_id], map: "idx_task_lists_user_id")
}

/// A task belongs to EITHER a task_list (list_id) OR a roadmap (roadmap_id) — exactly one is set.
model tasks {
  id           String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String      @db.Uuid
  list_id      String?     @db.Uuid
  roadmap_id   String?     @db.Uuid
  due_date     DateTime?   @db.Date
  title        String      @db.VarChar(255)
  description  String?
  status       String      @default("PENDING") @db.VarChar(20)
  priority     String      @default("NORMAL") @db.VarChar(20)
  completed_at DateTime?   @db.Timestamp(6)
  order_index  Int?        @default(0)
  created_at   DateTime?   @default(now()) @db.Timestamp(6)
  updated_at   DateTime?   @default(now()) @db.Timestamp(6)
  deleted_at   DateTime?   @db.Timestamp(6)
  task_lists   task_lists? @relation(fields: [list_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tasks_list")
  roadmaps     roadmaps?   @relation(fields: [roadmap_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tasks_roadmap")
  users        users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tasks_user")

  @@index([list_id], map: "idx_tasks_list_id")
  @@index([roadmap_id, due_date], map: "idx_tasks_roadmap_due")
  @@index([user_id], map: "idx_tasks_user_id")
}

enum todo_priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum todo_status {
  PENDING
  COMPLETED
  CANCELLED
}
